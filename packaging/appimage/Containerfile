FROM debian:13-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2 AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG RUNTIME=cpu

RUN apt-get update && apt-get install -y --no-install-recommends \
      adwaita-icon-theme build-essential ca-certificates curl file git \
      gobject-introspection libcairo2-dev libgirepository-2.0-dev \
      libgtk-4-1 libgtk-4-dev gir1.2-gtk-4.0 \
      gir1.2-webkit-6.0 \
      libgdk-pixbuf-2.0-0 libgdk-pixbuf-2.0-dev libgdk-pixbuf2.0-bin \
      libglib2.0-bin libwayland-dev meson ninja-build patchelf \
      python3 rsync squashfs-tools wayland-protocols \
      wl-clipboard xdotool grim xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 3 \
      https://github.com/astral-sh/uv/releases/download/0.11.21/uv-x86_64-unknown-linux-gnu.tar.gz \
      -o /tmp/uv.tar.gz \
    && echo "8c88519b0ef0af9801fcdee419bbb12116bd9e6b18e162ae093c932d8b264050  /tmp/uv.tar.gz" \
      | sha256sum -c - \
    && mkdir /tmp/uv \
    && tar -xzf /tmp/uv.tar.gz --strip-components=1 -C /tmp/uv \
    && install -Dm755 /tmp/uv/uv /usr/local/bin/uv \
    && rm -rf /tmp/uv /tmp/uv.tar.gz

RUN curl --fail --location --retry 3 \
      https://github.com/wmww/gtk4-layer-shell/archive/refs/tags/v1.3.0.tar.gz \
      -o /tmp/gtk4-layer-shell.tar.gz \
    && echo "1ebb01ab14e98afd1727f68f64981c37bd23305b1f131f5667c02b94cf593192  /tmp/gtk4-layer-shell.tar.gz" \
      | sha256sum -c - \
    && mkdir /tmp/gtk4-layer-shell \
    && tar -xzf /tmp/gtk4-layer-shell.tar.gz --strip-components=1 \
      -C /tmp/gtk4-layer-shell \
    && meson setup /tmp/gtk4-layer-shell/build /tmp/gtk4-layer-shell \
      --buildtype=release -Dtests=false -Dsmoke-tests=false -Dvapi=false \
    && meson compile -C /tmp/gtk4-layer-shell/build \
    && meson install -C /tmp/gtk4-layer-shell/build \
    && ldconfig \
    && rm -rf /tmp/gtk4-layer-shell /tmp/gtk4-layer-shell.tar.gz

RUN curl --fail --location --retry 3 \
      https://nodejs.org/dist/v22.23.0/node-v22.23.0-linux-x64.tar.xz \
      -o /tmp/node.tar.xz \
    && echo "14d7de44f235534799f8b171a4050d9a6a4bc99c87e053a25d3d54afa580aa20  /tmp/node.tar.xz" \
      | sha256sum -c - \
    && mkdir -p /opt/node \
    && tar -xJf /tmp/node.tar.xz \
      --no-same-owner --strip-components=1 -C /opt/node \
    && rm /tmp/node.tar.xz

RUN curl --fail --location --retry 3 \
      https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage \
      -o /opt/appimagetool \
    && echo "ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0  /opt/appimagetool" \
      | sha256sum -c - \
    && chmod +x /opt/appimagetool \
    && curl --fail --location --retry 3 \
      https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64 \
      -o /opt/runtime-x86_64 \
    && echo "2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d  /opt/runtime-x86_64" \
      | sha256sum -c -

ENV PATH="/opt/node/bin:${PATH}" \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=automatic

WORKDIR /src
COPY . .
RUN packaging/appimage/inner-build.sh "$RUNTIME" /out \
    && rm -rf \
      /opt/waystone-build-venv \
      /tmp/waystone-appimage \
      /tmp/waystone-models \
      /root/.cache/uv \
      /root/.local/share/uv \
      /src/brain/node_modules \
      /src/brain/dist

FROM scratch AS artifact
COPY --from=build /out/ /
