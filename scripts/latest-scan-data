#!/usr/bin/env python3
"""Print reviewable Level 1/2/3 truth for the latest retained scan."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _common  # noqa: E402

_common.bootstrap()

from poed import scan_review  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "scan",
        nargs="?",
        default="latest",
        help="retained scan id/path, or 'latest'",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="emit machine-readable scan review data",
    )
    args = parser.parse_args()

    try:
        scan_dir = scan_review.resolve_scan(args.scan)
        data = scan_review.run_current_scan(scan_dir)
    except (FileNotFoundError, RuntimeError) as e:
        raise SystemExit(str(e)) from e
    if args.json:
        print(json.dumps(scan_review.to_jsonable(data), indent=2, sort_keys=True))
    else:
        print(scan_review.format_review(data))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
